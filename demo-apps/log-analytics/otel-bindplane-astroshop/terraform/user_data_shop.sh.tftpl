#!/bin/bash
# Shop host bootstrap (cloud-init). Progress: /var/log/cloud-init-output.log; done marker: /var/log/lab-bootstrap-done
# Terraform template: shell variables are written $VAR (no braces), so only terraform's own placeholders expand.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
DEMO=/opt/opentelemetry-demo

# ---------- Docker + AWS CLI ----------
apt-get update -y
apt-get install -y ca-certificates curl git jq
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
usermod -aG docker ubuntu
snap install aws-cli --classic

# ---------- Astronomy Shop + lab overlay ----------
git clone --depth 1 --branch ${demo_ref} https://github.com/open-telemetry/opentelemetry-demo.git $DEMO
mkdir -p $DEMO/pii-log-generator
%{ for path, content in overlay ~}
echo '${content}' | base64 -d | gunzip > $DEMO/${path}
%{ endfor ~}

IMDS_TOKEN=$(curl -sfX PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PRIVATE_IP=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)

cp $DEMO/.env $DEMO/.env.orig
# The shop's services send OTLP to the Bindplane collector on this host instead of the demo's own collector.
sed -i "s|^OTEL_COLLECTOR_HOST=.*|OTEL_COLLECTOR_HOST=$PRIVATE_IP|" $DEMO/.env
sed -i "s|^OTEL_RESOURCE_ATTRIBUTES=\(.*\)|OTEL_RESOURCE_ATTRIBUTES=\1,deployment.environment=${deployment_env}|" $DEMO/.env
echo "COMPOSE_FILE=${compose_files}" >> $DEMO/.env
chown -R ubuntu:ubuntu $DEMO

# ---------- Bindplane collector ----------
# Postgres monitoring user: the demo's real password is the literal in init.sql (not the .env value).
PG_PW=$(sed -n "s/.*monitoring_user WITH PASSWORD '\([^']*\)'.*/\1/p" $DEMO/src/postgresql/init.sql)
install -m 600 /dev/null /etc/shop-agent.env
echo "POSTGRES_MONITORING_PASSWORD=$PG_PW" > /etc/shop-agent.env

SECRET=$(aws ssm get-parameter --region ${region} --name '${secret_param}' --with-decryption --query Parameter.Value --output text)
curl -fsSL https://bdot.bindplane.com/v${collector_version}/install_unix.sh -o /tmp/install_unix.sh
sh /tmp/install_unix.sh -e '${opamp_url}' -s "$SECRET" -v '${collector_version}' -k '${collector_labels}'
unset SECRET

# Root: the collector reads journald and /var/lib/docker/containers; the env file feeds the Postgres source.
mkdir -p /etc/systemd/system/observiq-otel-collector.service.d
cat > /etc/systemd/system/observiq-otel-collector.service.d/lab.conf <<'EOF'
[Service]
User=root
Group=root
EnvironmentFile=/etc/shop-agent.env
EOF
systemctl daemon-reload
systemctl restart observiq-otel-collector

# ---------- Start the shop (image pulls take 5-10 minutes) ----------
cd $DEMO
docker compose config -q
docker compose up -d --quiet-pull
touch /var/log/lab-bootstrap-done
