# Copy to lab.env (git-ignored) and fill in. Everything the lab needs comes from this file.
# No quotes or spaces in values. Lines starting with # are ignored.

# ---------------------------------------------------------------------------------------------------------------
# Naming: make these unique to you, so several SEs can share an AWS account or Dynatrace tenant
# ---------------------------------------------------------------------------------------------------------------
# AWS resource prefix and service.namespace: lowercase letters, digits, hyphens (max 30 chars)
LAB_NAME=otel-bindplane-lab
# deployment.environment on all EC2 telemetry. Dashboards, checks and OpenPipeline routes find your data by it.
DEPLOYMENT_ENV=otel-bindplane-lab

# Optional: rename every service to <SERVICE_PREFIX><name> in the collector (e.g. checkout -> JD-LAB-checkout).
# Off by default: services keep the names the shop sends. Turn it on in a shared tenant where another Astronomy
# Shop already reports "checkout", "frontend", ... and pick your own prefix (your initials, letters/digits/hyphens).
ENABLE_SERVICE_PREFIX=false
SERVICE_PREFIX=

# Owner tag on AWS resources
OWNER=jdoe@example.com

# ---------------------------------------------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------------------------------------------
# CLI profile to use (empty = default credential chain / environment variables)
AWS_PROFILE=
AWS_REGION=us-east-1
# Empty = first AZ of the region
AWS_AZ=
# Who can open the shop UI on port 8080. Use your own IP: curl -s https://checkip.amazonaws.com  -> x.x.x.x/32
UI_ALLOWED_CIDR=203.0.113.10/32
SHOP_INSTANCE_TYPE=m6i.xlarge
# Fixed public IP for the shop. Off by default: accounts allow few Elastic IPs per region (AddressLimitExceeded);
# without it the URL changes only if the instance is stopped and started (./lab.sh info prints it).
ENABLE_ELASTIC_IP=false

# ---------------------------------------------------------------------------------------------------------------
# Dynatrace
# ---------------------------------------------------------------------------------------------------------------
# Environment URL used for OTLP ingest (NOT the apps URL):
#   SaaS:    https://<env-id>.live.dynatrace.com
#   Sprint:  https://<env-id>.sprint.dynatracelabs.com
#   Managed: https://<host>/e/<env-id>
DT_ENV_URL=https://abc12345.live.dynatrace.com
# Access token with: openTelemetryTrace.ingest, metrics.ingest, logs.ingest
DT_INGEST_TOKEN=dt0c01.REPLACE_ME
# dtctl context pointing at the same tenant (dtctl ctx). Used for OpenPipeline routes, dashboards and checks.
# Leave empty to skip the Dynatrace automation and do those steps by hand.
DTCTL_CONTEXT=

# ---------------------------------------------------------------------------------------------------------------
# Bindplane (Cloud)
# ---------------------------------------------------------------------------------------------------------------
BINDPLANE_REMOTE_URL=https://app.bindplane.com
BINDPLANE_OPAMP_URL=wss://app.bindplane.com/v1/opamp
# Project Settings > API Keys (needs read/write on configurations, processors, destinations, rollouts)
# Project ID (Project Settings): required for project-scoped API keys (bps_...). Not a secret.
BINDPLANE_PROJECT=
BINDPLANE_API_KEY=REPLACE_ME
# Collectors > Install Collector: the "-s" value of the install command (secret key)
BINDPLANE_SECRET_KEY=REPLACE_ME
# Collector version the lab was validated with
BINDPLANE_COLLECTOR_VERSION=1.110.2

# ---------------------------------------------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------------------------------------------
# Archive the processed (redacted) logs to an S3 bucket created by terraform
ENABLE_S3_ARCHIVE=true
# Synthetic checkout/payment logs with fake card numbers and emails (~4 orders/min) for the PII redaction demo.
# Off by default. It is always installed on the host; switch it at any time, no rebuild:
#   ./lab.sh pii on | off | status
# true = ./lab.sh up switches it on at the end.
ENABLE_PII_GENERATOR=false
# Optional add-on: the shop on an EXISTING EKS cluster + a Bindplane node agent collecting its pod logs
ENABLE_EKS=false
EKS_KUBE_CONTEXT=
EKS_CLUSTER_NAME=
# EKS pod logs get service.name = <EKS_SERVICE_PREFIX><container>; the prefix is only used with ENABLE_SERVICE_PREFIX=true
EKS_SERVICE_PREFIX=
EKS_DEPLOYMENT_ENV=otel-bindplane-lab-eks

# opentelemetry-demo release (overlay files are written for 3.1.0)
DEMO_REF=3.1.0
